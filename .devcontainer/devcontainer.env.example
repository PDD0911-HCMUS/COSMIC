# Copy to .devcontainer/.env on radish. Both csMachine and ginger see this file.
COSMIC_SOURCE_PATH=/radish/phamd/duypd-proj/COSMIC
COSMIC_DATASETS_PATH=/radish/phamd/duypd-proj/SG-Retrieval/Datasets
# Docker mounts this existing directory at /workspace/app/Datasets.

# All GPUs are exposed to the container.
# Select a GPU per command, e.g. CUDA_VISIBLE_DEVICES=3 bash scripts/lab.sh train.
COSMIC_PROJECT_NAME=cosmic
COSMIC_IMAGE=cosmic:torch2.7.1-cu118
COSMIC_SHM_SIZE=2gb

# Driver 535 on ginger: retain PyTorch 2.7.1, use its CUDA 11.8 wheels.
COSMIC_TORCH_VERSION=2.7.1
COSMIC_TORCHVISION_VERSION=0.22.1
COSMIC_TORCH_CUDA=cu118

# Existing BERT/DINO assets must be copied before running offline.
COSMIC_OFFLINE=1

# Optional separate locations; defaults are directories in COSMIC_SOURCE_PATH.
# COSMIC_CACHE_PATH=/radish/phamd/duypd-proj/COSMIC/.cache
# COSMIC_OUTPUT_PATH=/radish/phamd/duypd-proj/COSMIC/outputs
# COSMIC_WEIGHTS_PATH=/radish/phamd/duypd-proj/COSMIC/data/OvSGTR/weights
